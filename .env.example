# Copie para .env (git-ignored) e ajuste se necessário.
# Os valores abaixo são os do ambiente local subido por `docker compose up -d`
# no repositório do backend (walletzen).

# Gateway — todas as chamadas de API passam por aqui
VITE_API_BASE_URL=http://localhost:8765

# Keycloak (Identity Provider)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=walletzen
VITE_KEYCLOAK_CLIENT_ID=walletzen-app
